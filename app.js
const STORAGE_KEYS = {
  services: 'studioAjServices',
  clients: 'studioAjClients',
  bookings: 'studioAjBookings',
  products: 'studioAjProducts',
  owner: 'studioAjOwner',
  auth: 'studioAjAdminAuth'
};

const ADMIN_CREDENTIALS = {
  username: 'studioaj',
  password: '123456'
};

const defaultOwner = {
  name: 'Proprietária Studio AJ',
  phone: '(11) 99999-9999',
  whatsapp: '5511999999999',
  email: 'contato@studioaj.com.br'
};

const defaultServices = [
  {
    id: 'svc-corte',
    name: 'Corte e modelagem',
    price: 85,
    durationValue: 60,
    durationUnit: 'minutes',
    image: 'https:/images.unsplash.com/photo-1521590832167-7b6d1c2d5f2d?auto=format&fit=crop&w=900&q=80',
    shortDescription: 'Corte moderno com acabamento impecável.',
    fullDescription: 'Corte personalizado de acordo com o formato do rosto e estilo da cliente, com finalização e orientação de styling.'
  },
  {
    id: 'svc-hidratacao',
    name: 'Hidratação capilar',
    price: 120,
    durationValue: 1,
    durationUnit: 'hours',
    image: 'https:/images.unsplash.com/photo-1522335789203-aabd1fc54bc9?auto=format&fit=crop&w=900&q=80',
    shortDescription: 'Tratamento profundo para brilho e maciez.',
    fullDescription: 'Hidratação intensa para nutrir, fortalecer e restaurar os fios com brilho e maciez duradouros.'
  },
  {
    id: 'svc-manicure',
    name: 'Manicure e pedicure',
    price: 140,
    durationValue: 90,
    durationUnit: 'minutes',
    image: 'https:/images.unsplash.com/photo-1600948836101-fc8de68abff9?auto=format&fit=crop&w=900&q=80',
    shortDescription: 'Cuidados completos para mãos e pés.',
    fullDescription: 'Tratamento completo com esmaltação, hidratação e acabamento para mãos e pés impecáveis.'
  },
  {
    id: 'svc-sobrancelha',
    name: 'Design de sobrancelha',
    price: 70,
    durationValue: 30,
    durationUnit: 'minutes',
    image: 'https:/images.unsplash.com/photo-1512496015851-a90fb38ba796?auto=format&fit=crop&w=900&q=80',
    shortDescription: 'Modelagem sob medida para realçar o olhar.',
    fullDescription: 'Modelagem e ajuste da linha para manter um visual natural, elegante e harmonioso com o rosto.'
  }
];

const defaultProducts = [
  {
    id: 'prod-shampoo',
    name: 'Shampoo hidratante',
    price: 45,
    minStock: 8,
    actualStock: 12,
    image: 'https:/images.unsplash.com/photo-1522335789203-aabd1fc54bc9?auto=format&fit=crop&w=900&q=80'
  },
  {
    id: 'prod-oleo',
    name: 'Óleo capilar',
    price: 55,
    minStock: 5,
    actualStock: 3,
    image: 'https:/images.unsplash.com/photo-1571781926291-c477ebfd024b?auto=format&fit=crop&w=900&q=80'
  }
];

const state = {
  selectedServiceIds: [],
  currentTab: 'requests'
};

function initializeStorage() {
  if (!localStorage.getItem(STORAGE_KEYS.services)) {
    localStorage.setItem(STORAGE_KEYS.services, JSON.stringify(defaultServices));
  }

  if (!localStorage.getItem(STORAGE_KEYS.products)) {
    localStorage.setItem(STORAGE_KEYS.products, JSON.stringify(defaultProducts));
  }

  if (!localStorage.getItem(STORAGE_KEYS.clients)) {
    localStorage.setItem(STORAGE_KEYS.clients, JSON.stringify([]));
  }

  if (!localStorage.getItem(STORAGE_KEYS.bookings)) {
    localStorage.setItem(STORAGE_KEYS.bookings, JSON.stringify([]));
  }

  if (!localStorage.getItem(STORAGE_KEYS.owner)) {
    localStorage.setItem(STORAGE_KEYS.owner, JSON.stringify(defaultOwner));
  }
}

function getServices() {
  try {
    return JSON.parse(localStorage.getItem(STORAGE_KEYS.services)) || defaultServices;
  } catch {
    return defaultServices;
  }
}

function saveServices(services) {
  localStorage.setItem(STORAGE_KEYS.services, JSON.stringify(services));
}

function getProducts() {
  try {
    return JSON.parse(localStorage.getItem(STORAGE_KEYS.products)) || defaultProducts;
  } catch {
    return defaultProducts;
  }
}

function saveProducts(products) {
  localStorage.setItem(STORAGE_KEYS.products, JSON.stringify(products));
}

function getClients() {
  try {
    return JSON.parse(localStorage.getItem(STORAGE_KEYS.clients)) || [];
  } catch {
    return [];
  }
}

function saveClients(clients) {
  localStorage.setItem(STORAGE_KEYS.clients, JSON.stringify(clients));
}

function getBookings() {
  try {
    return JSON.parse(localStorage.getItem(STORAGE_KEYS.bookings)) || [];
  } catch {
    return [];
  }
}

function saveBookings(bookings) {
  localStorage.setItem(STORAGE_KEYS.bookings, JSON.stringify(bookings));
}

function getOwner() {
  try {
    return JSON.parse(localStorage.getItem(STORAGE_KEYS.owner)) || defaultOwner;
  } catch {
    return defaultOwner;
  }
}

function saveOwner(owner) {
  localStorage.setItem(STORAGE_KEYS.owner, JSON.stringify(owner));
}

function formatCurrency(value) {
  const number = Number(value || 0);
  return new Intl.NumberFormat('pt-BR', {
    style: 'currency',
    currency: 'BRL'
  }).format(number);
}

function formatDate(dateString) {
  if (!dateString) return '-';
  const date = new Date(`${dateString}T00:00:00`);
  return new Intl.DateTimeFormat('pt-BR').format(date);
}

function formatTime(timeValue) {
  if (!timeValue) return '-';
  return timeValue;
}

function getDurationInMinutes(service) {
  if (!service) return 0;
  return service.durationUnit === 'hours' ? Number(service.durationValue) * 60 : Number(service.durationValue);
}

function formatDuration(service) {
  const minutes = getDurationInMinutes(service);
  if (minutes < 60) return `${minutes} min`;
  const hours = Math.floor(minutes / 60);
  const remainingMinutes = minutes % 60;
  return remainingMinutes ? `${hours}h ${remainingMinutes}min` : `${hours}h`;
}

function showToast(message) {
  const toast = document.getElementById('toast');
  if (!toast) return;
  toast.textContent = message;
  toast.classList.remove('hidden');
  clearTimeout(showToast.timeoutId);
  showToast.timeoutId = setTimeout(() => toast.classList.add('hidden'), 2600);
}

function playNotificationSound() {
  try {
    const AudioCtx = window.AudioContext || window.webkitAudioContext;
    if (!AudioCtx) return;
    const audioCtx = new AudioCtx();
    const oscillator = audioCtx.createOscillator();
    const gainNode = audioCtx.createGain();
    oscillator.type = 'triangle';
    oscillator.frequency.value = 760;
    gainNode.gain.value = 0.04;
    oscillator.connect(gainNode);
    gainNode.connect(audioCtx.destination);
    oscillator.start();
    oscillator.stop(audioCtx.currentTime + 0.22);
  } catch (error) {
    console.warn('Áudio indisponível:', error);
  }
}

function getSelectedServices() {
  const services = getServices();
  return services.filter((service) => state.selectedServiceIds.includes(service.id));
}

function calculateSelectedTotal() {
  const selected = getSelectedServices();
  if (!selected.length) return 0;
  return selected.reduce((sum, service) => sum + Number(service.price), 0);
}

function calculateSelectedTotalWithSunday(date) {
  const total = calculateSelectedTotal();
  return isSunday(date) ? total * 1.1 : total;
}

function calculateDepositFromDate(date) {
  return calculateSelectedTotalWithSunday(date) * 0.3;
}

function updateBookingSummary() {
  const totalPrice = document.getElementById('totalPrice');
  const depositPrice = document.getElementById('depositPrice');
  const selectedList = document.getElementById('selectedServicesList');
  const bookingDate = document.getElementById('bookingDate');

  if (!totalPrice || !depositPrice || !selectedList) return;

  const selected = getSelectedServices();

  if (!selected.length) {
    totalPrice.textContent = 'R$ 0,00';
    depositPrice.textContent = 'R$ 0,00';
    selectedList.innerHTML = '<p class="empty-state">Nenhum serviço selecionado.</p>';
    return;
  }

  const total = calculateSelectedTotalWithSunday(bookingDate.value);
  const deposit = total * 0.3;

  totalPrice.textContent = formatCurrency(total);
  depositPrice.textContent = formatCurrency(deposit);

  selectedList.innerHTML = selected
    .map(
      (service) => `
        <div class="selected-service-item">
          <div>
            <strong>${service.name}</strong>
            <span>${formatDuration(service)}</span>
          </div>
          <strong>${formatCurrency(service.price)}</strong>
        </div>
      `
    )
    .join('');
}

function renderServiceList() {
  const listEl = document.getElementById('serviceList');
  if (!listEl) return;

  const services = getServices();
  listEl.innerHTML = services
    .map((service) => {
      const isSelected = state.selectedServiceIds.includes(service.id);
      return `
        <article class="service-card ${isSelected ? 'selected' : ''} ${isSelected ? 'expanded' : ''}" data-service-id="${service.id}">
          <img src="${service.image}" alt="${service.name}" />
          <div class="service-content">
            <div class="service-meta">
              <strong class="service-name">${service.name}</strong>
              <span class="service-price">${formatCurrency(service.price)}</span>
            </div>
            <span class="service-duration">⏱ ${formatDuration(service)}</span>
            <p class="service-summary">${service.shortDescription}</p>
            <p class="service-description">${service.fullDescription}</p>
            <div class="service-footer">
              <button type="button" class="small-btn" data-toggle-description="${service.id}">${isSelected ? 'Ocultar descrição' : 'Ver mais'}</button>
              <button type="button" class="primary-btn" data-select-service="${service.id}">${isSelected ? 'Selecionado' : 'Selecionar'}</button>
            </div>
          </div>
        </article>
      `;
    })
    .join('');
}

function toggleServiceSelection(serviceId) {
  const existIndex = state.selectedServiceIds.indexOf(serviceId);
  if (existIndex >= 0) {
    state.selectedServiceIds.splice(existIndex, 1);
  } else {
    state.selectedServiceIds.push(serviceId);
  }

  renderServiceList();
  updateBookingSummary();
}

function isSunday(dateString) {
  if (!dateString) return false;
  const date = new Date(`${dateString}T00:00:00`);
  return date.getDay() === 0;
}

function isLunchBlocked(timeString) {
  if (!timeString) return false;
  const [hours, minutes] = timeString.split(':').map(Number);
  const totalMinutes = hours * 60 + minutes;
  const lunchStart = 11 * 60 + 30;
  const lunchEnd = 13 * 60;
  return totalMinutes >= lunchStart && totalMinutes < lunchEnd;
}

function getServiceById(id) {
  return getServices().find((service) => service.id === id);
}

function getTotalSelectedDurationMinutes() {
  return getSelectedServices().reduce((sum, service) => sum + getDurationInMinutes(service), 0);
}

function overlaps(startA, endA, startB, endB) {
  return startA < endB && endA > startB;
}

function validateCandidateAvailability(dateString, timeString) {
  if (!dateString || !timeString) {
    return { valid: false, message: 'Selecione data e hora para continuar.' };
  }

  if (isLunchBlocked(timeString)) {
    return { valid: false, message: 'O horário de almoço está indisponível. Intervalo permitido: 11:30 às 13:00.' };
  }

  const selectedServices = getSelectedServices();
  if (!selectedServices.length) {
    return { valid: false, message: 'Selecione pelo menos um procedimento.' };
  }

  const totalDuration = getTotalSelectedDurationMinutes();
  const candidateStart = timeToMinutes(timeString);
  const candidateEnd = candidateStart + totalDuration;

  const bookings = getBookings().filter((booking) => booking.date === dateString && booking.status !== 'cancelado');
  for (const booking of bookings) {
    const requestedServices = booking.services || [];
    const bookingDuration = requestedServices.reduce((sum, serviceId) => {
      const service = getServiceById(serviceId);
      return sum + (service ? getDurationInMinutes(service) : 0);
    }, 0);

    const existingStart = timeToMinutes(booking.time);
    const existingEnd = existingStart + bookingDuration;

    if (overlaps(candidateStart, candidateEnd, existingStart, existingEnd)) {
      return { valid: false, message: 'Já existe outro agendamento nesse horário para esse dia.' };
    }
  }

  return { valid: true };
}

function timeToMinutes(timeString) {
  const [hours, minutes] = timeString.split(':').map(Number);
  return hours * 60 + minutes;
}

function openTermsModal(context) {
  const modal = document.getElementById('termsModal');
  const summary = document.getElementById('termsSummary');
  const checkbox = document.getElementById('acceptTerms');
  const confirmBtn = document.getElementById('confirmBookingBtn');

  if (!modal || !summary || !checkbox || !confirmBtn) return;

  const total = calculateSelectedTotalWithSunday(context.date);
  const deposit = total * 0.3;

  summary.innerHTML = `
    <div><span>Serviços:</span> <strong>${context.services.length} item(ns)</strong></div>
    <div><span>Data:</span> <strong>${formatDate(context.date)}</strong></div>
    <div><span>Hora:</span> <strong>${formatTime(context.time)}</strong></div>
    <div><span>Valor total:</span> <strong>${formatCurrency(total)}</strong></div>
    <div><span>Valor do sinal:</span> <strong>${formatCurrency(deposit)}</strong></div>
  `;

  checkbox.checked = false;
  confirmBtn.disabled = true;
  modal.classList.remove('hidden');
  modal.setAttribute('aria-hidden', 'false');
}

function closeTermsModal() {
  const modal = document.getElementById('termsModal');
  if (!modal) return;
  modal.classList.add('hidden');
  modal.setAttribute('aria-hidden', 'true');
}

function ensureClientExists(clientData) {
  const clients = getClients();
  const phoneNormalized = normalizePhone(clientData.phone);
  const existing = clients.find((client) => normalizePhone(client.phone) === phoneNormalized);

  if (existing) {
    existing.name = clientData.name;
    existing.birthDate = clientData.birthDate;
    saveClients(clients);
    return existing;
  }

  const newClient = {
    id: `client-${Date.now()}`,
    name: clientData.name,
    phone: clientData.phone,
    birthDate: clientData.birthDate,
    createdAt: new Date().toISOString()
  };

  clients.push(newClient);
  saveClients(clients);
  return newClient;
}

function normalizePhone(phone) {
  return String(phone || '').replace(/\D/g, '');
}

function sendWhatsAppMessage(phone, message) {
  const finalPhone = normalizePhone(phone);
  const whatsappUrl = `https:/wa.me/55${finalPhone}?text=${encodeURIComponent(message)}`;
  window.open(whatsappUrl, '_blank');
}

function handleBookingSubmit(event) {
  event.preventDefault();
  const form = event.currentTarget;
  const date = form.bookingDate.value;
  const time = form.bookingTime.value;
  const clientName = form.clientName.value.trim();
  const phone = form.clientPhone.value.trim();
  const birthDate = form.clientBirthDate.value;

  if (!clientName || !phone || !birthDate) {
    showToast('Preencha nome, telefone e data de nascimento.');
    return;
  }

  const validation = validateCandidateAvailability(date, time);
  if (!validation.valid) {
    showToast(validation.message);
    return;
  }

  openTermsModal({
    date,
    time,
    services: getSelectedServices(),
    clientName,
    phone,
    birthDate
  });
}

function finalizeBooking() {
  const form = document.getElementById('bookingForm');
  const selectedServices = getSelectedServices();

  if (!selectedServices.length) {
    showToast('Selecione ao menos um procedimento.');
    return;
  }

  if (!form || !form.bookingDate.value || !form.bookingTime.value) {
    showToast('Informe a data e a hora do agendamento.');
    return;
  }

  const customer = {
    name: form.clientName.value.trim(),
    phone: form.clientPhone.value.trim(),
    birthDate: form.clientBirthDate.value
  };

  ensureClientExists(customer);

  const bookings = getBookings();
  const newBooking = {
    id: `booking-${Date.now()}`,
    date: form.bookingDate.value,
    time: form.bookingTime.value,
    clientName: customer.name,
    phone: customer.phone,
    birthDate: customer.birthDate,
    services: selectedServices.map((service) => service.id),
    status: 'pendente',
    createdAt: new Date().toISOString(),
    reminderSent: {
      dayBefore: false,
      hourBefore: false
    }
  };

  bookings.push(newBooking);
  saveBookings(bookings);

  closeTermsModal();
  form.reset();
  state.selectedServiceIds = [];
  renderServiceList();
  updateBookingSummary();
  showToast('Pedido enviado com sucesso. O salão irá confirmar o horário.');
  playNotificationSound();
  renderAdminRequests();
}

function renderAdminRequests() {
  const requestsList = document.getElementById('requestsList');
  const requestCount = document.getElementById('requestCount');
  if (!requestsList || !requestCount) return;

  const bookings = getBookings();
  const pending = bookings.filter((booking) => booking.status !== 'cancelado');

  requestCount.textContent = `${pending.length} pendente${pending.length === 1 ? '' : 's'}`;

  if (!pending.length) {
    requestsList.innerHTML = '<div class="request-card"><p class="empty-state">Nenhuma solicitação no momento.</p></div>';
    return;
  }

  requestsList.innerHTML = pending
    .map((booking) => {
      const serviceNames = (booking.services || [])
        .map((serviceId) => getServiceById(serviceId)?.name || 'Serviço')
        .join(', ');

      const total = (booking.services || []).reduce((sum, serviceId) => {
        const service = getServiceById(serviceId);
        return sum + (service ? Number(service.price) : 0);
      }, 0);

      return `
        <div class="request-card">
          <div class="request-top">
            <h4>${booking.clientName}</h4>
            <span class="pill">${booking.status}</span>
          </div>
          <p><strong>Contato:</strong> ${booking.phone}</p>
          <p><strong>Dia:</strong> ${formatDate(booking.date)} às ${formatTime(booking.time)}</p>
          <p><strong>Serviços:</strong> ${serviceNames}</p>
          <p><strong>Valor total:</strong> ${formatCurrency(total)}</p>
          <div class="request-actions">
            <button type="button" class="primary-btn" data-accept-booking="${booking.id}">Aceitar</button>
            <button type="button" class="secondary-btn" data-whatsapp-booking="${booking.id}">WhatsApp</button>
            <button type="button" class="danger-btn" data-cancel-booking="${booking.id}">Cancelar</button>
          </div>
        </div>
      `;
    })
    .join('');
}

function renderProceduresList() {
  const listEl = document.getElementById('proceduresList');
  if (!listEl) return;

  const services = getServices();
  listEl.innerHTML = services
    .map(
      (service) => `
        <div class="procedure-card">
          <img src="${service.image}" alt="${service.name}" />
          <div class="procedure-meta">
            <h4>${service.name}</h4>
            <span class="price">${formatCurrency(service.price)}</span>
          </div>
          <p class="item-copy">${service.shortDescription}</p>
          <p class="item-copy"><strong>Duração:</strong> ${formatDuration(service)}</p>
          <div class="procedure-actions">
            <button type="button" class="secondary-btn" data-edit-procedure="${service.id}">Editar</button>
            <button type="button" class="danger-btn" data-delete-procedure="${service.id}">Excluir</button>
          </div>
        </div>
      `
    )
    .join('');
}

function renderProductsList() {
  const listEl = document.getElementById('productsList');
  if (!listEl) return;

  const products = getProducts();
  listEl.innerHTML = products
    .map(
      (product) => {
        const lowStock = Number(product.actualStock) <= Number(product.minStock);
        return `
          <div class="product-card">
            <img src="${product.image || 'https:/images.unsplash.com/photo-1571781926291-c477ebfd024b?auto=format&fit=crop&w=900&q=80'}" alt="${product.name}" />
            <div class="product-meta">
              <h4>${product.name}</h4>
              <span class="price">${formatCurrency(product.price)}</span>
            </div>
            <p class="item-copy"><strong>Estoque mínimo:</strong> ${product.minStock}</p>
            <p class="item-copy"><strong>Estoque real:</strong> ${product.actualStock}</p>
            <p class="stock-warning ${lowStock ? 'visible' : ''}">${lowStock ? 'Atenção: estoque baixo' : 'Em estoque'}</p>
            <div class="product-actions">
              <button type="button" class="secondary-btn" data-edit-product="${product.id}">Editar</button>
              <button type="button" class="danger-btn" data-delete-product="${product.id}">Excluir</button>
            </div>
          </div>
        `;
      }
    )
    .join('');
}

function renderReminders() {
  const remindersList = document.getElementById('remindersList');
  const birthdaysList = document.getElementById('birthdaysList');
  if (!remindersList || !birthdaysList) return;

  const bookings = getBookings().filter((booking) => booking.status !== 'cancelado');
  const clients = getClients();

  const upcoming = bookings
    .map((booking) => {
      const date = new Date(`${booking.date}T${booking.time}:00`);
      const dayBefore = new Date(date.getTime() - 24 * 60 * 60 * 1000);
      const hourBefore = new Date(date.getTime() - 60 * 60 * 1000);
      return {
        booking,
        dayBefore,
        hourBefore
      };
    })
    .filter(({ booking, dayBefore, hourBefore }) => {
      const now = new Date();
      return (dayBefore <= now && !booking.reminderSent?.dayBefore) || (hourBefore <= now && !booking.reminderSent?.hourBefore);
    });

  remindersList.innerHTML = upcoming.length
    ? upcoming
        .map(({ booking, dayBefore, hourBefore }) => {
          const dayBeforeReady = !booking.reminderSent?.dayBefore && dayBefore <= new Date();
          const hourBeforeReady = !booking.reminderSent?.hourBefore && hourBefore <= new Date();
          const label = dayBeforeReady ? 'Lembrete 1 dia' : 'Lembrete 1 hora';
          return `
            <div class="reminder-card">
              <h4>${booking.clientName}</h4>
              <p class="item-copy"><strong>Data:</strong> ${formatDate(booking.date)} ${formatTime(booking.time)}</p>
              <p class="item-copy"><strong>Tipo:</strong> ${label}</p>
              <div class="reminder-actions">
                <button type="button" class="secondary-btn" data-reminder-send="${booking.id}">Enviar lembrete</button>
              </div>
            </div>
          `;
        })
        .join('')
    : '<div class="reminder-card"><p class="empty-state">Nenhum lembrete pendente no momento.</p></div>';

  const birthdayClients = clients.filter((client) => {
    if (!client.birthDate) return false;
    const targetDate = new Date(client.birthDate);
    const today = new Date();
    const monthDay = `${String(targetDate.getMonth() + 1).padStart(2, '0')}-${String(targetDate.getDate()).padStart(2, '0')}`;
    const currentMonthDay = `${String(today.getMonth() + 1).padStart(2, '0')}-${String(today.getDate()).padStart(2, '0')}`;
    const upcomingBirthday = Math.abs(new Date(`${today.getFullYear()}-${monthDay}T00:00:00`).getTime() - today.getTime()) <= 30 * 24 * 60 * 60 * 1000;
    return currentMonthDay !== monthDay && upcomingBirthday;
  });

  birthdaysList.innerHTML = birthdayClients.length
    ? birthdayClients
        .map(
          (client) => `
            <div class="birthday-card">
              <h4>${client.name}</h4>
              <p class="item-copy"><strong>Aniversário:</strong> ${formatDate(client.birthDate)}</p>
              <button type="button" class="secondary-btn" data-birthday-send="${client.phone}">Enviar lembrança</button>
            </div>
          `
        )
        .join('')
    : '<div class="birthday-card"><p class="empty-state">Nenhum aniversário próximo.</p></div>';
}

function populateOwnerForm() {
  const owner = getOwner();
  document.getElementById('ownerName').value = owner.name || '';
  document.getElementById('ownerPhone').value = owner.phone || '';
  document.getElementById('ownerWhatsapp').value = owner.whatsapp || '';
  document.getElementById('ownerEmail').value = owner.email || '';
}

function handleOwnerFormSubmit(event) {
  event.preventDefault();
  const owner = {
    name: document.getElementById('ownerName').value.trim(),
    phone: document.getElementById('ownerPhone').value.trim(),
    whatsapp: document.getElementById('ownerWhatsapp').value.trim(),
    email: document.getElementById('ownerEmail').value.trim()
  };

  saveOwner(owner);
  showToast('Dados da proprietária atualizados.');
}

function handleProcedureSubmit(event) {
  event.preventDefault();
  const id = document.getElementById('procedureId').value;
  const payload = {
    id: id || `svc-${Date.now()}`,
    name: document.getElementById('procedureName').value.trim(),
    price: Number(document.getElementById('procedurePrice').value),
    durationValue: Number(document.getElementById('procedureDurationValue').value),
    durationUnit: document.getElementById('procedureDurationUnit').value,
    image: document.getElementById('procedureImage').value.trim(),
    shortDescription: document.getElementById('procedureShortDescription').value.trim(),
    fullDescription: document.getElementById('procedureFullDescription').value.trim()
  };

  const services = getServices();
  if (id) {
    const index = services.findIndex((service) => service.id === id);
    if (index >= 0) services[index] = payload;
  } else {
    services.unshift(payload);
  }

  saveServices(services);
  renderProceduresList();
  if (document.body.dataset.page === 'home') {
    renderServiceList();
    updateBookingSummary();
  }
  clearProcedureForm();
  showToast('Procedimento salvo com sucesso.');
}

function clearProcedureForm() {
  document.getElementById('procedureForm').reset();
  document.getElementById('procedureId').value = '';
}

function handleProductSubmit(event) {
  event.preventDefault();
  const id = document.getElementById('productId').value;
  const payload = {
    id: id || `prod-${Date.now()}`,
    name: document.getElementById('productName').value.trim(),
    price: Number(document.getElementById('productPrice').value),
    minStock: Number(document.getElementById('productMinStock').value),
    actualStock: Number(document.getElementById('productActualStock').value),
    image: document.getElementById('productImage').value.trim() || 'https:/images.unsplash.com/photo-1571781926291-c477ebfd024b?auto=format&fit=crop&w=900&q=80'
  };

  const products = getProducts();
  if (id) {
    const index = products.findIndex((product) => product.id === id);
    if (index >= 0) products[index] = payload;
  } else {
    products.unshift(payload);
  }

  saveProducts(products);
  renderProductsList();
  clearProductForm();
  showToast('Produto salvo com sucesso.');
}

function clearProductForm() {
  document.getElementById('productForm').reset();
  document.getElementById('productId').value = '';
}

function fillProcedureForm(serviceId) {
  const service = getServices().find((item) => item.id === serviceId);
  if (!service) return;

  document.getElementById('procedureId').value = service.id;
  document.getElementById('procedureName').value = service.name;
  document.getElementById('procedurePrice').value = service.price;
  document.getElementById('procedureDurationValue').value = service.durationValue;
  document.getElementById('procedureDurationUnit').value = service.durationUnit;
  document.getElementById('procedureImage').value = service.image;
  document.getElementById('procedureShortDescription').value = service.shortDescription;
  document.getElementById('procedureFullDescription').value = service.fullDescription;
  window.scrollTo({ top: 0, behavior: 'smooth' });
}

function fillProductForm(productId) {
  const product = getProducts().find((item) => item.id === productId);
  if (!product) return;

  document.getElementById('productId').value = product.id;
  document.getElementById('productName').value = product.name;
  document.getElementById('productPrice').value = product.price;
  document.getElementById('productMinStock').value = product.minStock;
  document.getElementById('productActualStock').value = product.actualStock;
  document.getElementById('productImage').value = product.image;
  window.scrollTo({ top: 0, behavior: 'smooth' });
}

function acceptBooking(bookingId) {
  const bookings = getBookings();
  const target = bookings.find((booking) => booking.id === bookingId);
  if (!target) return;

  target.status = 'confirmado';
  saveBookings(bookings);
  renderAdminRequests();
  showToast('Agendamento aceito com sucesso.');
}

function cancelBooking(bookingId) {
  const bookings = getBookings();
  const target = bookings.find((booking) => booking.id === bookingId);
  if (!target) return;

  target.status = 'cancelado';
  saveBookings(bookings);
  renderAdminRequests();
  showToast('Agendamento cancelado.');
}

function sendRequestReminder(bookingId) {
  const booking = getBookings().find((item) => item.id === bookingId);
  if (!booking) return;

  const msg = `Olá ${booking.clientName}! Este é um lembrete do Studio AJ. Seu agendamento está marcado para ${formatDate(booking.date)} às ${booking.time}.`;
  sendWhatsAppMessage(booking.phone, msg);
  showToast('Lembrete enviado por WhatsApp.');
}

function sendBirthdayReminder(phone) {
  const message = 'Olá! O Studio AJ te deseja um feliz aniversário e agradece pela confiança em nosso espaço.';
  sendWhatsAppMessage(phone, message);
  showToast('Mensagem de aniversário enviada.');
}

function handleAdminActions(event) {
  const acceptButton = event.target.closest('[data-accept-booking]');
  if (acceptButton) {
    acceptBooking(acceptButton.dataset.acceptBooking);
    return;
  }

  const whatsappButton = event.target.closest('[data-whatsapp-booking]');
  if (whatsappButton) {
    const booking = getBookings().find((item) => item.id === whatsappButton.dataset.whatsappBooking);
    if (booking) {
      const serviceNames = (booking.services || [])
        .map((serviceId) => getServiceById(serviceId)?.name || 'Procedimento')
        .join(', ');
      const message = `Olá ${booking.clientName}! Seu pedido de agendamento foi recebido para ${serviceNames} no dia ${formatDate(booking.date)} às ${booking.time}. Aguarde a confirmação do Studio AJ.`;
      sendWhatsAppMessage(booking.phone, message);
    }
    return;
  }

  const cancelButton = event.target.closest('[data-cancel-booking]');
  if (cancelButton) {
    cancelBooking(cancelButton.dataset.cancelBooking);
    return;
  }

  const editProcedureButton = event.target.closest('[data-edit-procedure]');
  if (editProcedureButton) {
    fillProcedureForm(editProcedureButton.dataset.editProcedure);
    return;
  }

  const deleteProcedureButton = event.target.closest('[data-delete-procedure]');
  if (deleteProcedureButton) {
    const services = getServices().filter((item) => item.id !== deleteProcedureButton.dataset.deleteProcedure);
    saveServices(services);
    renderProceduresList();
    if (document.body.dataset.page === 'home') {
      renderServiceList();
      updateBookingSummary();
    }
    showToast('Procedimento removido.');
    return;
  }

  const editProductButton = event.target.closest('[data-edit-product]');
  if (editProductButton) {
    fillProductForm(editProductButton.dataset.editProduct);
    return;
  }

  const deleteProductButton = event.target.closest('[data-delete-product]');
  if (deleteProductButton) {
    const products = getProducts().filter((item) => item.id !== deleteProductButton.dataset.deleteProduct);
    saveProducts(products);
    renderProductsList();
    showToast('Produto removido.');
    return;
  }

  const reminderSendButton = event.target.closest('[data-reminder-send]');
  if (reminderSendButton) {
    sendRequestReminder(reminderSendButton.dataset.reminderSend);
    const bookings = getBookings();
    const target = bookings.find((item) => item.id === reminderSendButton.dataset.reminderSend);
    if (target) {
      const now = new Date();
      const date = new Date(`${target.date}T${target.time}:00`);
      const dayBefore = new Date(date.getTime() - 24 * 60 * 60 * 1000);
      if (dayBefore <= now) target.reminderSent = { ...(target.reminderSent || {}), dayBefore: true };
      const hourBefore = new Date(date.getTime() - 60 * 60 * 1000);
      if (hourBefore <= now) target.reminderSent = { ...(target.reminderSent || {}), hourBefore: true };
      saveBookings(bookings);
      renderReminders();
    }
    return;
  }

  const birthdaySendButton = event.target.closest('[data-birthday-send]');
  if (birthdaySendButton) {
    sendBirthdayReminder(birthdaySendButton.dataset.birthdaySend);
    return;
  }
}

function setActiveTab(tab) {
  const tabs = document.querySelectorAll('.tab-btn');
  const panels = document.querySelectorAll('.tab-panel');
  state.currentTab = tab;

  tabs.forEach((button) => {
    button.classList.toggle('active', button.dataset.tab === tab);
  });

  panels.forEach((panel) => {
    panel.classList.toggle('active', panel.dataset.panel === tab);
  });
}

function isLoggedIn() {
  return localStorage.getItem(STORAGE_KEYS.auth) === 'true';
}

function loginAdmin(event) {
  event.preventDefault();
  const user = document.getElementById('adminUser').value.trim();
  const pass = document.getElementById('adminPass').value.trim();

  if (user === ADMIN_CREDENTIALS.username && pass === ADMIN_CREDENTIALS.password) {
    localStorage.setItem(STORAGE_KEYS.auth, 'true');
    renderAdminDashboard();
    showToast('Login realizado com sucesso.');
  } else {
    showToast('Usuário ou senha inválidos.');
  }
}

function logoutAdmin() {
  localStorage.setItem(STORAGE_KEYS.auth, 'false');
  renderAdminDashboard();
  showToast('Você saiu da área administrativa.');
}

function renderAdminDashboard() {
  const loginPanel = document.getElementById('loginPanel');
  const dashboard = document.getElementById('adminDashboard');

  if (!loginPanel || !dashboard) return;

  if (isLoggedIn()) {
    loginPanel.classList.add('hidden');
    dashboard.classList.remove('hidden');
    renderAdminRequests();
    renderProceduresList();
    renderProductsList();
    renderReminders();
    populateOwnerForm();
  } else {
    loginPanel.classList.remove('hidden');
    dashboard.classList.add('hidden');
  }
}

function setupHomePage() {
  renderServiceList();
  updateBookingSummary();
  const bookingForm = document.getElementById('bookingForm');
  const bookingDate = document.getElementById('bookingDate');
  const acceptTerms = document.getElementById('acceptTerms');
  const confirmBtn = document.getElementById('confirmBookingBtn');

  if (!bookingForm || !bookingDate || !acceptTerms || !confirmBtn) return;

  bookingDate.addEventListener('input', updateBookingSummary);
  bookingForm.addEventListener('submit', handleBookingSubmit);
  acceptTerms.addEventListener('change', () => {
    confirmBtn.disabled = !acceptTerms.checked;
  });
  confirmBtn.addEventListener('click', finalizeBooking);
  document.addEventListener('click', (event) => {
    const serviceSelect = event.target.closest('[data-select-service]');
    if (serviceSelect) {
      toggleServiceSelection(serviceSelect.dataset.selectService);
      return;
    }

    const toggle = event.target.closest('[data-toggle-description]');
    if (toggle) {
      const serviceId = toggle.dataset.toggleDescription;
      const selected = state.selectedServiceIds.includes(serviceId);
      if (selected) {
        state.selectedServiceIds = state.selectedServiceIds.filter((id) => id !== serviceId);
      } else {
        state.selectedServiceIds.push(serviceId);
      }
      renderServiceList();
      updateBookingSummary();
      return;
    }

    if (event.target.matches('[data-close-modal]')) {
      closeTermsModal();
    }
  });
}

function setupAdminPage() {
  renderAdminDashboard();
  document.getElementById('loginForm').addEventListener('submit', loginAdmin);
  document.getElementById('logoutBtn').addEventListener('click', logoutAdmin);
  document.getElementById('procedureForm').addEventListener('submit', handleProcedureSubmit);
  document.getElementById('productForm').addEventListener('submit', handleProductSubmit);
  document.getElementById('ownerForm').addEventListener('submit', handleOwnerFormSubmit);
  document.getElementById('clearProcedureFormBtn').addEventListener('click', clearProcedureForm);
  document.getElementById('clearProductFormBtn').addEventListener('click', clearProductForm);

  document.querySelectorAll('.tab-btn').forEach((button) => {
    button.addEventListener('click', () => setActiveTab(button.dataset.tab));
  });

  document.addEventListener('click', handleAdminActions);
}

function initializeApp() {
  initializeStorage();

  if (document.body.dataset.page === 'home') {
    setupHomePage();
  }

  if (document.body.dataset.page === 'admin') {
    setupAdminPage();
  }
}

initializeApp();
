:root {
  --bg: #fdf6f9;
  --glass: rgba(255, 255, 255, 0.9);
  --panel: #ffffff;
  --panel-soft: #fff0f5;
  --text: #281d2b;
  --muted: #6a5b69;
  --primary: #ea93b0;
  --primary-strong: #d75b87;
  --primary-dark: #9b3d5d;
  --primary-soft: #ffeef5;
  --line: #f0dfe9;
  --success: #2e9a71;
  --warning: #f1c96f;
  --danger: #d74b4b;
  --black: #0b0b0d;
  --shadow: 0 22px 45px rgba(65, 39, 52, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: "Inter", sans-serif;
  background: linear-gradient(180deg, #fffafc 0%, #fff5f8 100%);
  color: var(--text);
}

img {
  display: block;
  max-width: 100%;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(234, 147, 176, 0.12);
}

.black-header {
  background: #07070a;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.nav-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
}

.logo-section {
  display: flex;
  align-items: center;
}

.logo-box {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  font-size: 1.4rem;
  box-shadow: var(--shadow);
}

.black-header .logo-mark {
  background: linear-gradient(135deg, #ffb9ce, #f7659c);
  color: #13070d;
}

.logo-text strong,
.logo-text small {
  display: block;
}

.logo-text strong {
  font-size: 1.2rem;
  letter-spacing: 0.08em;
  color: var(--text);
}

.black-header .logo-text strong,
.black-header .logo-text small {
  color: #fff;
}

.logo-text small {
  color: var(--muted);
  font-size: 0.72rem;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 20px;
  font-weight: 600;
  color: var(--muted);
}

.black-header .main-nav {
  color: rgba(255, 255, 255, 0.78);
}

.main-nav a:hover,
.nav-active {
  color: var(--primary-dark);
}

.black-header .nav-active,
.black-header .main-nav a:hover {
  color: #ffbfd2;
}

.page-shell {
  padding: 32px 0 60px;
}

.hero-panel {
  background: linear-gradient(135deg, rgba(234, 147, 176, 0.14), rgba(255, 255, 255, 0.85));
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 32px;
  display: grid;
  grid-template-columns: 1.5fr 0.9fr;
  gap: 24px;
  align-items: center;
  box-shadow: var(--shadow);
}

.eyebrow {
  margin: 0 0 10px;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--primary-dark);
}

.hero-copy h1,
.section-header h2,
.dashboard-topbar h2 {
  margin: 0;
}

.hero-copy h1 {
  font-size: clamp(2.4rem, 5vw, 4rem);
  line-height: 1.1;
  letter-spacing: -0.06em;
}

.hero-copy p:last-child {
  margin-top: 16px;
  color: var(--muted);
  line-height: 1.7;
  max-width: 540px;
}

.hero-badge {
  justify-self: end;
  min-width: 240px;
  background: rgba(11, 11, 13, 0.96);
  color: white;
  border-radius: 22px;
  padding: 22px 20px;
  box-shadow: var(--shadow);
}

.hero-badge span,
.hero-badge small {
  display: block;
  color: rgba(255, 255, 255, 0.75);
}

.hero-badge strong {
  display: block;
  margin: 10px 0 8px;
  font-size: 1.2rem;
}

.services-section,
.booking-panel,
.admin-shell,
.panel-block,
.login-panel {
  margin-top: 42px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22px;
}

.section-header h2 {
  font-size: clamp(1.8rem, 4vw, 2.5rem);
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 24px;
}

.service-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 15px 28px rgba(111, 84, 94, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.service-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 22px 35px rgba(111, 84, 94, 0.13);
}

.service-card.selected {
  border-color: var(--primary-strong);
  box-shadow: 0 0 0 4px rgba(215, 91, 135, 0.08);
}

.service-card img {
  height: 220px;
  width: 100%;
  object-fit: cover;
}

.service-content {
  padding: 18px;
  display: grid;
  gap: 12px;
}

.service-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.service-name {
  font-size: 1.15rem;
  font-weight: 700;
}

.service-price {
  color: var(--primary-dark);
  font-weight: 800;
}

.service-duration {
  display: inline-flex;
  width: fit-content;
  align-items: center;
  gap: 8px;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 0.78rem;
  font-weight: 700;
  padding: 8px 10px;
  border-radius: 999px;
}

.service-summary,
.service-description,
.empty-state,
.item-copy,
.summary-copy {
  color: var(--muted);
  line-height: 1.6;
  margin: 0;
}

.service-description {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.25s ease;
}

.service-card.expanded .service-description {
  max-height: 220px;
  opacity: 1;
}

.service-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: 4px;
}

.primary-btn,
.secondary-btn,
.danger-btn,
.small-btn,
.tab-btn {
  border: none;
  border-radius: 14px;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-btn,
.secondary-btn,
.danger-btn,
.small-btn {
  padding: 11px 16px;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
  color: white;
  box-shadow: 0 16px 28px rgba(215, 91, 135, 0.2);
}

.primary-btn:disabled {
  opacity: 0.52;
  cursor: not-allowed;
  box-shadow: none;
}

.secondary-btn {
  background: #fff;
  color: var(--text);
  border: 1px solid var(--line);
}

.danger-btn {
  background: rgba(215, 75, 75, 0.08);
  color: var(--danger);
  border: 1px solid rgba(215, 75, 75, 0.12);
}

.small-btn {
  background: var(--panel-soft);
  color: var(--primary-dark);
  border: 1px solid var(--line);
}

.full-width {
  width: 100%;
}

.booking-panel,
.panel-block,
.login-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 26px;
  box-shadow: 0 18px 32px rgba(115, 77, 93, 0.08);
}

.selected-services-container {
  background: var(--panel-soft);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 18px;
}

.selected-services-container h3 {
  margin: 0 0 14px;
}

.selected-services-list {
  display: grid;
  gap: 10px;
}

.selected-service-item {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  background: white;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 12px 14px;
}

.selected-service-item strong {
  display: block;
  margin-bottom: 4px;
}

.selected-service-item span {
  color: var(--muted);
  font-size: 0.88rem;
}

.booking-pricing {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-top: 20px;
}

.pricing-item {
  background: var(--panel-soft);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 16px 18px;
  display: grid;
  gap: 6px;
}

.pricing-item span {
  color: var(--muted);
}

.pricing-item strong {
  font-size: 1.3rem;
  color: var(--primary-dark);
}

.grid {
  display: grid;
  gap: 18px;
}

.two-col {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.booking-form,
.stack-form,
.login-form {
  display: grid;
  gap: 18px;
}

.field-group {
  display: grid;
  gap: 8px;
}

label {
  font-weight: 600;
}

input,
textarea,
select {
  width: 100%;
  border-radius: 14px;
  border: 1px solid var(--line);
  min-height: 52px;
  padding: 12px 14px;
  background: #fff;
  color: var(--text);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

input:focus,
textarea:focus,
select:focus {
  outline: none;
  border-color: rgba(215, 91, 135, 0.8);
  box-shadow: 0 0 0 4px rgba(215, 91, 135, 0.08);
}

textarea {
  min-height: 112px;
  resize: vertical;
}

.modal {
  position: fixed;
  inset: 0;
  background: rgba(15, 9, 12, 0.6);
  display: grid;
  place-items: center;
  z-index: 50;
  padding: 20px;
}

.modal.hidden,
.toast.hidden,
.hidden {
  display: none !important;
}

.modal-card {
  width: min(620px, 100%);
  background: white;
  border-radius: 24px;
  box-shadow: var(--shadow);
  overflow: hidden;
  border: 1px solid rgba(215, 91, 135, 0.14);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  border-bottom: 1px solid var(--line);
}

.modal-header h3 {
  margin: 0;
  font-size: 1.4rem;
}

.icon-close {
  border: none;
  background: transparent;
  font-size: 2rem;
  color: var(--muted);
  cursor: pointer;
}

.modal-body {
  padding: 20px;
  display: grid;
  gap: 18px;
}

.terms-content {
  display: grid;
  gap: 10px;
  line-height: 1.7;
}

.terms-content p {
  margin: 0;
}

.highlight {
  color: var(--primary-dark);
}

.alert {
  color: var(--danger);
}

.terms-summary {
  background: var(--panel-soft);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 16px 18px;
  display: grid;
  gap: 8px;
}

.checkbox-row {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 600;
}

.checkbox-row input {
  width: 18px;
  min-height: 18px;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  padding: 0 20px 20px;
}

.toast {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 60;
  background: #130d11;
  color: white;
  padding: 12px 16px;
  border-radius: 12px;
  box-shadow: var(--shadow);
}

.admin-shell {
  padding: 32px 0 60px;
}

.login-panel {
  display: grid;
  place-items: center;
  min-height: 60vh;
}

.login-card {
  width: min(450px, 100%);
}

.login-card h2 {
  margin: 0 0 6px;
}

.login-card p {
  margin: 0 0 18px;
  color: var(--muted);
}

.dashboard {
  display: grid;
  gap: 22px;
}

.dashboard-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 22px 0 0;
}

.dashboard-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.tab-btn {
  background: var(--panel-soft);
  color: var(--text);
  padding: 10px 14px;
  font-weight: 700;
  border: 1px solid var(--line);
}

.tab-btn.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
  color: white;
}

.tab-panel {
  display: none;
  gap: 22px;
}

.tab-panel.active {
  display: grid;
}

.list-stack,
.list-grid {
  display: grid;
  gap: 16px;
}

.list-grid {
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

.request-card,
.reminder-card,
.product-card,
.procedure-card,
.birthday-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 16px;
  box-shadow: 0 10px 18px rgba(110, 92, 96, 0.05);
}

.request-card,
.reminder-card,
.birthday-card {
  display: grid;
  gap: 10px;
}

.request-top,
.product-meta,
.procedure-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 8px 10px;
  border-radius: 999px;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 0.76rem;
  font-weight: 700;
}

.request-actions,
.procedure-actions,
.product-actions,
.reminder-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.request-status {
  font-weight: 700;
  color: var(--success);
}

.product-card img,
.procedure-card img {
  width: 100%;
  height: 160px;
  object-fit: cover;
  border-radius: 14px;
  margin-bottom: 12px;
}

.product-card h4,
.procedure-card h4,
.request-card h4,
.reminder-card h4,
.birthday-card h4 {
  margin: 0;
}

.product-card .price,
.procedure-card .price {
  color: var(--primary-dark);
  font-weight: 800;
}

.product-card .stock-warning {
  color: var(--danger);
  font-weight: 700;
}

.form-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

@media (max-width: 760px) {
  .hero-panel,
  .two-col,
  .booking-pricing {
    grid-template-columns: 1fr;
  }

  .main-nav {
    gap: 12px;
    font-size: 0.9rem;
  }

  .nav-wrap,
  .dashboard-topbar,
  .service-footer,
  .modal-actions,
  .form-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .selected-service-item,
  .request-top,
  .procedure-meta,
  .product-meta {
    flex-direction: column;
    align-items: flex-start;
  }
}
